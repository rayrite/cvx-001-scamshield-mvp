# --- required for real research (unset = demo mode with a canned walkthrough) ---
ZAI_API_KEY=

# --- models (verified 2026-09-20 on docs.z.ai) ---
ZAI_API_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_INTAKE_MODEL=glm-5.3-flash        # vision transcriptionist (screenshots)
ZAI_RESEARCH_MODEL=glm-5.3            # staged reasoning + built-in web_search
# GLM-5.x thinking cannot be disabled; this is the only depth/cost lever
# (low | high | max — API default is max; the skill's rubrics carry the
# scaffolding, so low is the hosted default). GLM-5.2+ only.
ZAI_REASONING_EFFORT=low

# --- timeouts (seconds) ---
ZAI_INTAKE_TIMEOUT=120
ZAI_RESEARCH_TIMEOUT=300

# --- budgets / safety caps ---
MAX_STAGE_CALLS=10                    # model calls per staged job before forced consolidation
MAX_IMAGES=5
MAX_CHAT_TURNS=12                     # user turns per chat/quick conversation

# --- optional shared-secret gate for the API (leave unset for open demo) ---
# AGENT_TOKEN=change-me

# --- where job state + reports live (Railway Volume mount target) ---
DATA_DIR=./data
